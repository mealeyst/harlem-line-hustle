---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Card, CardHeader, CardBody, Button, Logo, Typography } from '@harlem-line-hustle/ui';
import { getEntry } from 'astro:content';

const dungeonDevils = await getEntry('projects', 'dungeon-delvers');
---

<BaseLayout
  title="About"
  description="Learn about Harlem Hustle Studios and the games we're making."
  currentPath="/about"
>
  <!-- ── Page header ────────────────────────────────────────── -->
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">About</p>
      <Logo size="lg" glitch />
      <p class="page-subtitle">The small but mighty independent game studio.</p>
    </div>
  </section>

  <!-- ── Studio section ────────────────────────────────────── -->
  <section class="studio-section">
    <div class="container">
      <div class="two-col">
        <div class="col-text">
          <p class="section-mono">// THE STUDIO</p>
          <h2 class="section-title">Built for the browser.<br />Built in the city.</h2>
          <div class="body-stack">
            <p class="body-text">
              Harlem Line Hustle Studios is an independent solo development studio based out of Pawling
              New York. We are working on creating 3D games and interactive worlds that players can
              get lost inside.
            </p>
            <p class="body-text">
              The studio lead is a seasoned web development veteran who is now leveraging the
              programming language Zig to bring his home brewed fantasy realm to life natively on
              all major operating systems.
            </p>
          </div>
        </div>
        <div class="col-stat">
          <div class="stat-block">
            <span class="stat-number">1</span>
            <span class="stat-label">Game in<br />Development</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-block">
            <span class="stat-number">1</span>
            <span class="stat-label">Caffinated<br />Required</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-block">
            <span class="stat-number">∞</span>
            <span class="stat-label">Ambition</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container"><hr class="divider" /></div>

  <!-- ── Dungeon Devils feature ─────────────────────────────── -->
  <section class="featured-game">
    <div class="container">
      <p class="section-mono">// FEATURED PROJECT</p>

      <div class="game-hero">
        <div class="game-hero-text">
          <div class="game-status-row">
            <span class="status-badge">{dungeonDevils?.data.status}</span>
          </div>
          <h2 class="game-title">{dungeonDevils?.data.title}</h2>
          <p class="game-tagline">{dungeonDevils?.data.tagline}</p>
          <p class="game-description">{dungeonDevils?.data.description}</p>

          <div class="game-tags">
            {dungeonDevils?.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
          </div>

          <div class="game-actions">
            <Button
              as="a"
              href="https://codeberg.org/mealeyst/dungeon_delvers"
              variant="primary"
              size="md"
            >
              Follow Development
            </Button>
          </div>
        </div>

        <div class="game-hero-aside">
          <div class="feature-list">
            <p class="feature-list-label">// PLANNED FEATURES</p>
            <ul class="feature-items">
              <li class="feature-item">
                <span class="feature-bullet">▸</span>
                Real-time single player combat
              </li>
              <li class="feature-item">
                <span class="feature-bullet">▸</span>
                Procedurally generated dungeons
              </li>
              <li class="feature-item">
                <span class="feature-bullet">▸</span>
                Full 3D rendered natively on OSX, Windows, and Linux
              </li>
              <li class="feature-item">
                <span class="feature-bullet">▸</span>
                Party-based combat
              </li>
              <li class="feature-item">
                <span class="feature-bullet">▸</span>
                Character progression & crafting
              </li>
              <li class="feature-item">
                <span class="feature-bullet">▸</span>
                Persistent world state
              </li>
              <li class="feature-item">
                <span class="feature-bullet">▸</span>
                4 Archetypes: Healer, Scout, Mage, and Fighter playable to level 10
              </li>
              <li class="feature-item">
                <span class="feature-bullet">▸</span>
                4 Playable Races: Human, Dwarf, Orc, and Goblin
              </li>
              <li class="feature-item">
                <span class="feature-bullet">▸</span>
                1 Quest Hub: Queen's Port
              </li>
              <li class="feature-item">
                <span class="feature-bullet">▸</span>
                1 Overland Zone: Saltspray Bluffs
              </li>
              <li class="feature-item">
                <span class="feature-bullet">▸</span>
                1 Dungeon: The Forsaken Cairn
              </li>
              <li class="feature-item">
                <span class="feature-bullet">▸</span>
                10 Unique Monsters
              </li>
              <li class="feature-item">
                <span class="feature-bullet">▸</span>
                10 Weapon Types
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="gallery">
        <p class="gallery-label">// GALLERY</p>
        <div class="gallery-grid">
          <figure class="gallery-item">
            <video
              class="gallery-video"
              src="/blog/moving-to-zig/skeleton.mp4"
              autoplay
              muted
              loop
              playsinline
              controls
            />
            <figcaption class="gallery-caption">Skeleton</figcaption>
          </figure>
          <figure class="gallery-item">
            <video
              class="gallery-video"
              src="/blog/moving-to-zig/goblin_idle.mp4"
              autoplay
              muted
              loop
              playsinline
              controls
            />
            <figcaption class="gallery-caption">Goblin</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <div class="container"><hr class="divider" /></div>

  <!-- ── Tech stack ─────────────────────────────────────────── -->
  <section class="tech-section">
    <div class="container">
      <p class="section-mono">// TECH STACK</p>
      <h2 class="section-title-sm">How We Build</h2>
      <div class="tech-grid">
        {
          [
            { name: 'Zig', desc: 'Systems programming language' },
            { name: 'Mach', desc: 'Native game engine' },
            { name: 'TypeScript', desc: 'Typed everywhere' },
            { name: 'Astro', desc: 'Static site generation' },
            { name: 'React', desc: 'Interactive UI islands' },
          ].map(({ name, desc }) => (
            <Card variant="outlined">
              <CardBody>
                <p class="tech-name">{name}</p>
                <p class="tech-desc">{desc}</p>
              </CardBody>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <style>
    /* ── Page header ──────────────────────────────────────────── */

    .page-header {
      padding: var(--space-20) 0 var(--space-12);
      border-bottom: var(--border);
    }

    .eyebrow {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-widest);
      text-transform: uppercase;
      color: var(--color-text-dim);
      margin: 0 0 var(--space-4);
    }

    .page-title {
      font-family: var(--font-sans);
      font-size: clamp(var(--text-4xl), 8vw, var(--text-6xl));
      font-weight: 200;
      line-height: var(--leading-tight);
      letter-spacing: var(--tracking-tight);
      color: var(--color-text);
      text-shadow: var(--glow-text);
      margin: 0 0 var(--space-6);
    }

    .page-subtitle {
      font-family: var(--font-sans);
      font-size: var(--text-lg);
      font-weight: 300;
      color: var(--color-text-muted);
      margin: 0;
    }

    /* ── Studio section ───────────────────────────────────────── */

    .studio-section {
      padding: var(--space-20) 0;
    }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
      align-items: start;
    }

    @media (max-width: 768px) {
      .two-col {
        grid-template-columns: 1fr;
        gap: var(--space-12);
      }
    }

    .col-text {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .body-stack {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .body-text {
      font-family: var(--font-sans);
      font-size: var(--text-base);
      font-weight: 300;
      line-height: var(--leading-relaxed);
      color: var(--color-text-muted);
      margin: 0;
    }

    .col-stat {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      padding: var(--space-8);
      border: var(--border);
      border-radius: var(--radius-md);
    }

    .stat-block {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .stat-number {
      font-family: var(--font-sans);
      font-size: var(--text-5xl);
      font-weight: 200;
      line-height: 1;
      color: var(--color-primary-200);
      text-shadow: var(--glow-text-strong);
    }

    .stat-label {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-wider);
      text-transform: uppercase;
      color: var(--color-text-dim);
      line-height: var(--leading-normal);
    }

    .stat-divider {
      height: 1px;
      background-color: var(--color-border);
    }

    /* ── Shared section elements ──────────────────────────────── */

    .section-mono {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-widest);
      color: var(--color-accent);
      text-shadow: var(--glow-accent);
      margin: 0 0 var(--space-6);
    }

    .section-title {
      font-family: var(--font-sans);
      font-size: var(--text-3xl);
      font-weight: 300;
      letter-spacing: var(--tracking-tight);
      color: var(--color-text);
      text-shadow: var(--glow-text);
      margin: 0 0 var(--space-6);
      line-height: var(--leading-snug);
    }

    .section-title-sm {
      font-family: var(--font-sans);
      font-size: var(--text-2xl);
      font-weight: 300;
      letter-spacing: var(--tracking-tight);
      color: var(--color-text);
      text-shadow: var(--glow-text);
      margin: 0 0 var(--space-4);
    }

    /* ── Dungeon Devils ───────────────────────────────────────── */

    .featured-game {
      padding: var(--space-20) 0;
    }

    .game-hero {
      display: grid;
      grid-template-columns: 1fr 360px;
      gap: var(--space-16);
      align-items: start;
    }

    @media (max-width: 960px) {
      .game-hero {
        grid-template-columns: 1fr;
      }
    }

    .game-hero-text {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .game-status-row {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .status-badge {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-wider);
      text-transform: uppercase;
      color: var(--color-accent);
      text-shadow: var(--glow-accent);
      border: 1px solid var(--color-secondary-600);
      border-radius: var(--radius-sm);
      padding: 2px var(--space-2);
    }

    .game-title {
      font-family: var(--font-sans);
      font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
      font-weight: 200;
      line-height: var(--leading-tight);
      letter-spacing: var(--tracking-tight);
      color: var(--color-text);
      text-shadow: var(--glow-text-strong);
      margin: 0;
    }

    .game-tagline {
      font-family: var(--font-sans);
      font-size: var(--text-xl);
      font-weight: 300;
      color: var(--color-text-muted);
      font-style: italic;
      margin: 0;
    }

    .game-description {
      font-family: var(--font-sans);
      font-size: var(--text-base);
      font-weight: 300;
      line-height: var(--leading-relaxed);
      color: var(--color-text-muted);
      margin: 0;
      max-width: 560px;
    }

    .game-tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .game-actions {
      padding-top: var(--space-2);
    }

    /* ── Feature list ─────────────────────────────────────────── */

    .feature-list {
      border: 1px solid var(--color-primary-600);
      border-radius: var(--radius-md);
      padding: var(--space-6);
      background-color: var(--color-bg-elevated);
    }

    .feature-list-label {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-widest);
      color: var(--color-text-dim);
      margin: 0 0 var(--space-5);
    }

    .feature-items {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .feature-item {
      display: flex;
      align-items: flex-start;
      gap: var(--space-3);
      font-family: var(--font-sans);
      font-size: var(--text-sm);
      font-weight: 300;
      color: var(--color-text-muted);
      line-height: var(--leading-normal);
    }

    .feature-bullet {
      color: var(--color-primary-400);
      text-shadow: var(--glow-text);
      flex-shrink: 0;
      margin-top: 1px;
    }

    /* ── Gallery ───────────────────────────────────────────────── */

    .gallery {
      margin-top: var(--space-16);
    }

    .gallery-label {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-widest);
      color: var(--color-accent);
      text-shadow: var(--glow-accent);
      margin: 0 0 var(--space-6);
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
    }

    .gallery-item {
      margin: 0;
      border: 1px solid var(--color-primary-600);
      border-radius: var(--radius-md);
      background-color: var(--color-bg-elevated);
      overflow: hidden;
    }

    .gallery-video {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      background-color: var(--color-bg);
    }

    .gallery-caption {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-wide);
      color: var(--color-text-dim);
      padding: var(--space-2) var(--space-3);
      margin: 0;
    }

    /* ── Tech section ─────────────────────────────────────────── */

    .tech-section {
      padding: var(--space-20) 0;
    }

    .tech-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: var(--space-4);
    }

    .tech-name {
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--color-primary-200);
      text-shadow: var(--glow-text);
      margin: 0 0 var(--space-1);
      letter-spacing: var(--tracking-wide);
    }

    .tech-desc {
      font-family: var(--font-sans);
      font-size: var(--text-xs);
      color: var(--color-text-dim);
      margin: 0;
      letter-spacing: var(--tracking-wide);
    }
  </style>
</BaseLayout>
